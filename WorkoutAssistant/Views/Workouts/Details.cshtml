@model WorkoutAssistant.Web.ViewModels.Workout.WorkoutDetailsViewModel

@{
    ViewData["Title"] = "Workout Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-4">
            <h1 class="h2 mb-1">Workout Details</h1>
            <p class="text-muted mb-0">View the details of this workout.</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex flex-row gap-1 justify-content-end mb-3">
                    <a asp-controller="WorkoutPlans"
                       asp-action="Details"
                       asp-route-id="@Model.PlanId"
                       class="btn btn-outline-secondary">
                        Back to workout plan
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                </div>

                <h2 class="card-title h4">@Model.Name</h2>
                <h3 class="h5 mt-4">Exercises</h3>

                @if (Model.Exercises.Count == 0)
                {
                    <p class="text-muted mb-0">There are no exercises in this workout yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var exercise in Model.Exercises)
                        {
                            <li class="list-group-item px-0">@exercise.Name</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
