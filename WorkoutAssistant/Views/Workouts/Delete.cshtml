@model WorkoutAssistant.Web.Models.Workout.WorkoutListViewModel

@{
    ViewData["Title"] = "Delete Workout";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-4">
            <h1 class="h2 mb-1">Delete Workout</h1>
            <p class="text-muted mb-0">Are you sure you want to delete this workout?</p>
        </div>

        <div class="card border-danger shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title h4">@Model.Name</h2>

                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">Delete workout</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
