@model WorkoutAssistant.Web.InputModels.ExerciseEditInputModel
@using WorkoutAssistant.Shared.Enums

@{
    ViewData["Title"] = "Edit Exercise";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-4">
            <h1 class="h2 mb-1">Edit Exercise</h1>
            <p class="text-muted mb-0">Update the details of this exercise.</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="WorkoutId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Exercise name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MuscleGroup" class="form-label">Muscle group</label>
                        <select asp-for="MuscleGroup" asp-items="Html.GetEnumSelectList<MuscleGroup>()" class="form-select"></select>
                        <span asp-validation-for="MuscleGroup" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-sm-4 mb-3">
                            <label asp-for="Sets" class="form-label"></label>
                            <input asp-for="Sets" class="form-control" />
                            <span asp-validation-for="Sets" class="text-danger"></span>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <label asp-for="Reps" class="form-label"></label>
                            <input asp-for="Reps" class="form-control" />
                            <span asp-validation-for="Reps" class="text-danger"></span>
                        </div>
                        <div class="col-sm-4 mb-3">
                            <label asp-for="RestSeconds" class="form-label">Rest (seconds)</label>
                            <input asp-for="RestSeconds" class="form-control" />
                            <span asp-validation-for="RestSeconds" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="MediaUrl" class="form-label">Media URL <span class="text-muted">(optional)</span></label>
                        <input asp-for="MediaUrl" class="form-control" />
                        <span asp-validation-for="MediaUrl" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
