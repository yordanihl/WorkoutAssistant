@model WorkoutAssistant.Web.Models.Exercise.ExerciseAddInputModel
@using WorkoutAssistant.Shared.Enums

@{
    ViewData["Title"] = "Add Exercise";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-4">
            <h1 class="h2 mb-1">Add Exercise</h1>
            <p class="text-muted mb-0">Add an exercise to this workout.</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Add" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <input asp-for="WorkoutId" type="hidden" />

                    <partial name="_ExerciseFields" model="Model" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Workouts"
                           asp-action="Details"
                           asp-route-id="@Model.WorkoutId"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">Create exercise</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
