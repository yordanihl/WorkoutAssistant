@model WorkoutAssistant.Data.Models.WorkoutPlan

@{
    ViewData["Title"] = "Workout Plan Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-4">
            <h1 class="h2 mb-1">Workout Plan Details</h1>
            <p class="text-muted mb-0">View the details of this workout plan.</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title h4">@Model.Title</h2>
                <p class="card-text text-muted mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                </p>
                <a asp-action="Index" class="btn btn-outline-secondary">Back to workout plans</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
            </div>
        </div>
    </div>
</div>
