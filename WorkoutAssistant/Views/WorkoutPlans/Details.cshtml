@model WorkoutAssistant.Web.ViewModels.WorkoutPlan.WorkoutPlanDetailsViewModel

@{
    ViewData["Title"] = "Workout Plan Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-4">
            <h1 class="h2 mb-1">Workout Plan Details</h1>
            <p class="text-muted mb-0">View the details of this workout plan.</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex flex-row gap-1 justify-content-end mb-1">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to workout plans</a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                </div>
                <h2 class="card-title h4">@Model.Title</h2>
                <p class="card-text text-muted mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                </p>
                <h2 class="h4 mt-4">Workouts</h2>
                @if (Model.Workouts.Count == 0)
                {
                    <p class="text-muted">There are no workouts in this plan yet.</p>
                }
                else
                {
                    <ol>
                        @foreach (var workout in Model.Workouts)
                        {
                            <li>
                                <a asp-controller="Workouts"
                                   asp-action="Details"
                                   asp-route-id="@workout.Id">
                                    @workout.Name
                                </a>
                            </li>
                        }
                    </ol>
                }
                <div class="d-flex flex-row gap-1">
                    <a asp-controller="Workouts" asp-action="Add" asp-route-id="@Model.Id" class="btn btn-outline-primary">Add</a>
                    @if (Model.Workouts.Count > 1)
                    {
                        <a asp-action="ReorderWorkouts" asp-route-id="@Model.Id" class="btn btn-outline-primary">Reorder</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
