@model IEnumerable<WorkoutAssistant.Web.ViewModels.WorkoutPlan.WorkoutPlanViewModel>;

@{
    ViewData["Title"] = "Workout Plans";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Workout Plans</h1>
        <p class="text-muted mb-0">Browse your available workout plans.</p>
    </div>
    <a asp-action="Add" class="btn btn-primary">Add</a>
</div>

@if (Model?.Any() == true)
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var plan in Model)
        {
            <div class="col">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h2 class="card-title h5">@plan.Title</h2>
                        <p class="card-text text-muted mb-0">
                            @(string.IsNullOrWhiteSpace(plan.Description) ? "No description provided." : plan.Description)
                        </p>
                        <div>
                            <a asp-action="Details" asp-route-id="@plan.Id" class="btn btn-primary">Details</a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info" role="status">
        No workout plans are available yet.
    </div>
}