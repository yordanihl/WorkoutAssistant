@model WorkoutAssistant.Web.ViewModels.WorkoutPlan.WorkoutPlanViewModel

@{
    ViewData["Title"] = "Delete Workout Plan";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-4">
            <h1 class="h2 mb-1">Delete Workout Plan</h1>
            <p class="text-muted mb-0">Are you sure you want to delete this workout plan?</p>
        </div>

        <div class="card border-danger shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title h4">@Model.Title</h2>
                <p class="card-text text-muted mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                </p>

                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger">Delete workout plan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
