@model WorkoutAssistant.Data.Models.WorkoutPlan

@{
    ViewData["Title"] = "Add Workout Plan";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="mb-4">
            <h1 class="h2 mb-1">Add Workout Plan</h1>
            <p class="text-muted mb-0">Create a plan to organize your workouts.</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Add" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Plan name</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Full Body Strength" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Description <span class="text-muted">(optional)</span></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the goal or focus of this plan."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create plan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}